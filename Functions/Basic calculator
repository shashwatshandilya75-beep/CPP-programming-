#include <iostream>
using namespace std;

void calculate(double a, double b, char op) {
    switch(op) {
        case '+': cout << "Result: " << a + b; break;
        case '-': cout << "Result: " << a - b; break;
        case '*': cout << "Result: " << a * b; break;
        case '/': 
            if(b != 0) cout << "Result: " << a / b;
            else cout << "Error: Division by zero!";
            break;
        default: cout << "Invalid Operator";
    }
    cout << endl;
}

int main() {
    double num1, num2;
    char op;
    cout << "Enter two numbers and an operator (+, -, *, /): ";
    cin >> num1 >> num2 >> op;
    calculate(num1, num2, op);
    return 0;
}
