#include <iostream>
#include <string>

using namespace std;

class Hospital {
private:
    string patientName;
    string disease;
    float temp;

public:
    Hospital(string name, string dis, float t) {
        patientName = name;
        disease = dis;
        temp = t;
    }

    void CheckStatus() {
        if (temp <= 99.0) {
            cout << "Condition: Normal." << endl;
        } 
        else {
            cout << "Condition: Fever Detected!" << endl;
            cout << "Action: Please visit the doctor immediately." << endl;
        }
    }
};

int main() {
    string name, dis;
    float temperature;

    cout << "--- Hospital Management ---" << endl;
    
    cout << "Enter Patient Name: ";
    getline(cin, name);
    
    cout << "Enter Disease: ";
    getline(cin, dis);
    
    cout << "Enter Temperature: ";
    cin >> temperature;

    Hospital patient(name, dis, temperature);
    patient.CheckStatus();

    return 0;
}
