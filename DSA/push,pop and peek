#include <iostream> 
using namespace std; 

#define MAX 5 
int stack[MAX]; 
int top = -1; 

void push(int element) { 
    if (top == MAX - 1) { 
        cout << "stack overflowed\n"; 
        return; 
    } 
    top = top + 1; 
    stack[top] = element; 
    cout << "element " << element << " has been inserted: \n"; 
} 


void pop() {
    if (top == -1) {
        cout << "stack underflowed (stack is empty)\n";
        return;
    }
    cout << "element " << stack[top] << " has been popped\n";
    top = top - 1;
}

void peek() {
    if (top == -1) {
        cout << "stack is empty\n";
        return;
    }
    cout << "top element is: " << stack[top] << "\n";
}


void display() { 
    if (top == -1) { 
        cout << "stack is empty\n"; 
        return; 
    } 
    cout << "elements are : \n"; 
    for (int i = top; i >= 0; i--) { 
        cout << stack[i] << " "; 
    } 
    cout << "\n";
}

int main() {
    push(10);
    push(20);
    push(30);
    push(40);
    push(50);
    push(60);
    
    display();
    pop();
    pop();
    pop();
    peek();
    display();
    
    return 0;
}
